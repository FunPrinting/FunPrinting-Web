# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/print-service
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/print-service

# Razorpay Configuration (Test Mode)
# Razorpay (docs/PAYMENTS.md). Use rzp_test_ keys outside production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when creating the webhook (URL: /api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=
# 1 = send the partner's 90% share as a Razorpay Route transfer (held until printed).
# Leave empty until Route is activated on the Razorpay account.
RAZORPAY_ROUTE_ENABLED=
# Public site URL used in Razorpay callback links, e.g. https://www.funprinting.store
# Leave empty on preview deployments to use each deployment's own URL.
APP_BASE_URL=

# Storage Provider Selection
# Options: 'oracle' or 'cloudinary'
# Default: 'cloudinary' (for backward compatibility)
STORAGE_PROVIDER=oracle

# Cloudinary Configuration (for backward compatibility or fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Oracle Cloud Infrastructure (OCI) Configuration
# Get these from: https://cloud.oracle.com/
# Free Tier: 20GB object storage (10GB standard + 10GB infrequent access)
# No file size limits, no API call limits
OCI_TENANCY_OCID=ocid1.tenancy.oc1..your_tenancy_ocid
OCI_USER_OCID=ocid1.user.oc1..your_user_ocid
OCI_FINGERPRINT=
# Option 1: Path to private key file (recommended for local development)
OCI_PRIVATE_KEY_PATH=~/.oci/oci_api_key.pem
# Option 2: Private key content as environment variable (recommended for cloud deployment)
# OCI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
OCI_REGION=us-ashburn-1
# Get namespace from: OCI Console > Object Storage > Bucket Details
OCI_NAMESPACE=your_namespace
OCI_BUCKET_NAME=print-service-files
# Optional: Compartment OCID (defaults to tenancy OCID if not set)
# OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..your_compartment_ocid

# NextAuth Configuration
# REQUIRED. Signs NextAuth sessions AND partner device tokens (/api/partner/desktop-token).
# Must be identical to NEXTAUTH_SECRET on the funprinting-wss server.
# There is no fallback: partner token issue/verification fails with 500 if unset.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Optional: Scope session cookies across all subdomains for SSO (e.g. .funprinting.store)
COOKIE_DOMAIN=

# Subdomain Configuration (Optional)
# Subdomain name for admin (defaults to 'admin' if unset)
ADMIN_SUBDOMAIN=admin
# Set to 'true' to 307-redirect root /admin traffic to the admin subdomain once DNS is live
REDIRECT_ADMIN_SUBDOMAIN=

# Google OAuth Configuration
# Get these from: https://console.developers.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin Configuration
# Comma-separated admin allowlist (users with role 'admin' are also admins).
ADMIN_EMAILS=
# Single admin email (legacy; merged into the allowlist). Also receives admin notifications.
ADMIN_EMAIL=
# NEXT_PUBLIC_ADMIN_EMAIL is still read for backward compatibility only.
# ADMIN_PASSWORD is only used by scripts/setup-admin.js (no default).
ADMIN_PASSWORD=

# Cron Job Configuration
# REQUIRED for /api/cron/*. Send as 'Authorization: Bearer <CRON_SECRET>' (Vercel Cron does this
# automatically) or legacy 'x-cron-secret'. Cron routes return 401 when this is unset.
CRON_SECRET=

# WebSocket print server (funprinting-wss). No fallback URL: dispatch is skipped if unset.
WSS_API_URL=
# Shared HMAC secret for web -> WSS dispatch/cancel calls (must match WSS_DISPATCH_SECRET on the WSS)
WSS_DISPATCH_SECRET=


# Email Configuration for Notifications
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_USE_TLS=True

# Adobe PDF Services API Configuration (FREE)
# Get these from: https://developer.adobe.com/console/
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_ORG_ID=
ADOBE_ACCOUNT_ID=

# Cloudmersive Document Conversion API Configuration (FREE - 800 conversions/month)
# Get your API key from: https://cloudmersive.com/
CLOUDMERSIVE_API_KEY=
# More DOCX→PDF services (optional; tried in order, see docs/DOCUMENTS.md)
CONVERTAPI_SECRET=
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=
# RENDER_SERVICE_URL=https://render-pdf-service.fly.dev
# RENDER_SERVICE_DISABLED=1
# LIBREOFFICE_PATH=/usr/bin/soffice
# DOCX_TO_PDF_PROVIDERS=cloudmersive,convertapi,ilovepdf,libreoffice,render
# Extra hosts the server may download stored files from (comma separated, host or host/path)
# FILE_URL_HOSTS=

INVOICE_ENABLED=true
RETRY_QUEUE_ENABLED=true

# === Shiprocket (courier delivery, docs/DELIVERY.md) ===
# API user from Shiprocket → Settings → API (a separate email from your main login)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Token for the tracking webhook (Shiprocket → Settings → API → Webhooks, x-api-key);
# URL: https://<site>/api/webhooks/courier-updates
SHIPROCKET_WEBHOOK_TOKEN=
# Default parcel weight in kg when an order has no page counts
SHIPROCKET_DEFAULT_WEIGHT=0.5
# Each shop is registered as its own pickup address automatically; no fixed pickup location.
# Error tracking (docs/ERROR_TRACKING.md). Errors are stored in MongoDB and shown at /admin/errors.
# Set to 1 to turn capture off.
ERROR_TRACKING_DISABLED=

# Print job deadlines (docs/PRINT_JOBS.md). Optional: without these, deadlines are
# enforced by sweeps (partner job list) and the daily reconcile cron.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Partner app access tokens (docs/PARTNER_AUTH.md). Same value on the WSS server.
# At least 32 characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PARTNER_JWT_SECRET=
# Turn away partner apps older than this (426 Upgrade Required). Leave empty until the new apps are released.
MIN_DESKTOP_APP_VERSION=
MIN_MOBILE_APP_VERSION=
